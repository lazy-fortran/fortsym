# Build trees
build/
build-*/
/build/
*.mod
*.smod
*.o
*.a
*.so
*.so.*
.cache/

# fpm
build/dependencies/

# Fetched dependencies. Yacas and (optionally) SymEngine are built from source
# into the build tree by cmake/deps/*.cmake; nothing fetched is ever committed.
_deps/
external/

# Test and benchmark output. Benchmark tables are regenerated by every test run,
# so committing them would produce churn on every machine.
benchmark-results/
*.bench.json
*.suite.json
Testing/

# Editor and tooling
compile_commands.json
.vscode/
.idea/
*.swp
tags

# Python tooling used by the SymPy engine probe
__pycache__/
*.pyc

# Agent worktrees and scratch state. Never repository content.
.claude/
.provenance/

# CI compiler cache
.ccache/
