@PACKAGE_INIT@

# The installed shared target exposes the Fortran modules and C ABI, and
# FortGen, whose modules its kernel interfaces use. The symbolic engines and
# arithmetic libraries remain runtime dependencies only.
include(CMakeFindDependencyMacro)
find_dependency(fortgen CONFIG HINTS "${CMAKE_CURRENT_LIST_DIR}/../fortgen")
include("${CMAKE_CURRENT_LIST_DIR}/fortsymTargets.cmake")
