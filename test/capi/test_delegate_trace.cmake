file(GLOB old_traces "${TRACE_PREFIX}.*.json")
if(old_traces)
    file(REMOVE ${old_traces})
endif()
set(environment "FORTSYM_DISABLE_FLINT_EXACT=0" "FORTSYM_DISABLE_FLINT_ALGEBRAIC=0"
    "FORTSYM_DISABLE_SYMENGINE_EVAL=0" "FORTSYM_COUNT_DELEGATES=0")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${environment}
    "FORTSYM_TRACE_DELEGATES=" "${FIXTURE}" default
    RESULT_VARIABLE plain_status OUTPUT_VARIABLE plain ERROR_VARIABLE plain_error)
execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${environment}
    "FORTSYM_TRACE_DELEGATES=${TRACE_PREFIX}" "${FIXTURE}" counted
    RESULT_VARIABLE traced_status OUTPUT_VARIABLE traced ERROR_VARIABLE traced_error)
if(NOT plain_status EQUAL 0 OR NOT traced_status EQUAL 0)
    message(FATAL_ERROR "delegate fixture failed: ${plain_error}${traced_error}")
endif()
if(NOT plain STREQUAL traced)
    message(FATAL_ERROR "tracing changed exact or requested-precision results")
endif()
file(GLOB traces "${TRACE_PREFIX}.*.json")
list(LENGTH traces count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "expected exactly one per-process trace")
endif()
list(GET traces 0 path)
file(READ "${path}" trace)
string(JSON schema GET "${trace}" schema)
string(JSON exact_attempts GET "${trace}" delegates flint-exact attempts)
string(JSON exact_successes GET "${trace}" delegates flint-exact successes)
string(JSON algebraic_attempts GET "${trace}" delegates flint-algebraic attempts)
string(JSON eval_attempts GET "${trace}" delegates symengine-eval attempts)
string(JSON eval_successes GET "${trace}" delegates symengine-eval successes)
if(NOT schema STREQUAL "fortsym-direct-delegates-v1" OR exact_attempts LESS 1
    OR exact_successes LESS 1 OR NOT algebraic_attempts EQUAL 0
    OR NOT eval_attempts EQUAL 1 OR NOT eval_successes EQUAL 1)
    message(FATAL_ERROR "unexpected delegate trace: ${trace}")
endif()
file(REMOVE "${path}")

file(WRITE "${TRACE_PREFIX}.wl" "small = 2 + 3\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${environment}
    "FORTSYM_TRACE_DELEGATES=${TRACE_PREFIX}" "${RUNNER}" "${TRACE_PREFIX}.wl"
    RESULT_VARIABLE small_status OUTPUT_VARIABLE small ERROR_VARIABLE small_error)
file(REMOVE "${TRACE_PREFIX}.wl")
if(NOT small_status EQUAL 0 OR NOT small MATCHES "R\tsmall\t5")
    message(FATAL_ERROR "small-only runner failed: ${small_error}")
endif()
file(GLOB traces "${TRACE_PREFIX}.*.json")
list(LENGTH traces count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "small-only runner omitted its zero-counter trace")
endif()
list(GET traces 0 path)
file(READ "${path}" trace)
foreach(group IN ITEMS flint-exact flint-algebraic symengine-eval)
    string(JSON attempts GET "${trace}" delegates "${group}" attempts)
    string(JSON successes GET "${trace}" delegates "${group}" successes)
    if(NOT attempts EQUAL 0 OR NOT successes EQUAL 0)
        message(FATAL_ERROR "small arithmetic unexpectedly used a delegate: ${trace}")
    endif()
endforeach()
file(REMOVE "${path}")
